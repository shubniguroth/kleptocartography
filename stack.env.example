# Klepto Cartographer environment template.
# Portainer: Stack -> Environment variables -> "Load variables from .env file".
# Plain Docker: copy to stack.env next to docker-compose.yml.
# Blank values are treated as unset. Never commit the filled-in copy.

# --- Tile account that owns (or has been shared) the Tiles ---
TILE_EMAIL=
TILE_PASSWORD=

# --- Which Tiles to show ---
# Value = Tile name exactly as in the Tile app (case-insensitive) OR the Tile UUID.
# List both from the running container: python -m klepto.tiles  (or open /api/tiles).
# Leave all blank for discovery mode (every Tile on the account is shown).
TRACKER_1=
TRACKER_2=
TRACKER_3=
# Optional per tracker: TRACKER_1_LABEL=A  TRACKER_1_NAME=Camera bag  TRACKER_1_COLOR=#0072B2  TRACKER_1_NOTE=...

# --- Zones (optional) ---
# Format: Name:lat,lon,radius_m[,away] ; separated by semicolons. Right-click the map for coordinates.
# Zones are "home" (where trackers belong) unless marked ",away".
ZONES=

# --- Map ---
# Optional Google Maps JavaScript API key (restrict it to your domain). Blank = free OpenStreetMap layers.
GOOGLE_MAPS_JS_KEY=
# google_roadmap | google_hybrid | streets | dark | satellite | osm
MAP_DEFAULT_LAYER=google_roadmap

# --- Street addresses: nominatim (free) | google | none ---
GEOCODER=nominatim
GOOGLE_GEOCODING_KEY=

# --- Alerts (left all home zones / came back / not heard for STALE_HOURS) ---
ALERTS_ENABLED=false
APPRISE_URLS=
STALE_HOURS=24

# --- Monitoring: a Healthchecks.io-style check URL (pinged every poll, /fail on errors) ---
HEALTHCHECKS_URL=

# --- Cloudflare tunnel token for the optional cloudflared service ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Misc ---
TITLE=Klepto Cartographer
SUBTITLE=Last known locations
TIMEZONE=UTC
TZ=UTC
POLL_INTERVAL_SECONDS=180
KLEPTO_DEMO=0
KLEPTO_LOG_LEVEL=INFO
